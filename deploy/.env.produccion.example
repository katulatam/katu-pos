# Variables de producción de Katú POS (las mismas en app1 y app2).
# En Portainer se cargan en el stack → "Environment variables". Nunca se suben al repositorio.

# ── Dominio ──
PUBLIC_URL=https://app.katupos.com          # webhooks de Stripe, Twilio y Alanube
DOMINIO_BASE=katupos.com                     # cada empresa: <subdominio>.katupos.com
LANDING_URL=https://www.katupos.com

# ── Base de datos (réplica de 3 nodos; ver deploy/mongo) ──
MONGO_URI=mongodb://katupos:CLAVE@10.0.0.3:27017,10.0.0.4:27017/katu_pos?replicaSet=rs0&authSource=admin

# ── Sesión (genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=
JWT_EXPIRES_IN=12h
KATU_ADMIN_EMAIL=katu@katulatam.com
KATU_ADMIN_PASSWORD=

# ── Facturación electrónica (Alanube, producción) ──
ALANUBE_API_URL=https://api.alegra.com/e-provider/col/v1
ALANUBE_TOKEN=

# ── Pagos QR ──
KATUPAY_URL=https://api.katupay.dev

# ── WhatsApp (Twilio, cuenta maestra) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── IA (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Correo (SendGrid) ──
SENDGRID_API_KEY=
SENDGRID_FROM=no-responder@katupos.com
# Plantillas dinámicas (deploy/sendgrid/). Vacías = se usa el diseño del código
SENDGRID_TEMPLATE_BIENVENIDA=
SENDGRID_TEMPLATE_RECUPERAR=

# ── Suscripciones (Stripe) ──
# Empieza con las claves de prueba (sk_test_…) y cambia a las reales (sk_live_…) al lanzar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                       # whsec_… del endpoint https://app.katupos.com/api/v1/registro/stripe
DIAS_GRACIA_SUSCRIPCION=7
DIAS_PRUEBA_GRATIS=15                        # prueba gratis sin tarjeta desde la landing (0 = desactivada)
PLAN_PRUEBA=premium                          # código del plan que se prueba
KATU_AVISOS_CORREO=                          # correo del equipo Katú para avisos internos (p. ej. registrar un número de WhatsApp)
