# ── Servidor ──
PORT=3008
NODE_ENV=development
PUBLIC_URL=https://pos.katulatam.com
# true = los QR se aprueban solos (solo para demos, nunca en producción)
MODO_DEMO=false

# ── Base de datos (sin DB_HOST ni MONGO_URI arranca en memoria con datos demo) ──
BD_USER=
BD_PASS=
DB_HOST=
DB_NAME=katu_pos
DB_AUTH_SOURCE=admin
DB_REPLICA_SET=
DB_TLS=false
DB_CA_FILE=
# MONGO_URI=   (alternativa: cadena completa, tiene prioridad)

# ── Sesión ──
JWT_SECRET=
JWT_EXPIRES_IN=12h
KATU_ADMIN_EMAIL=katu@katulatam.com
KATU_ADMIN_PASSWORD=

# ── Facturación electrónica Colombia ──
# Pruebas:     https://sandbox-api.alegra.com/e-provider/col/v1  (token de sandbox)
# Producción:  https://api.alegra.com/e-provider/col/v1
ALANUBE_API_URL=https://sandbox-api.alegra.com/e-provider/col/v1
ALANUBE_TOKEN=

# ── Pagos QR ──
KATUPAY_URL=https://api.katupay.dev

# ── WhatsApp (Twilio, cuenta maestra de Katú) ──
# Cada comercio usa una subcuenta creada desde el admin. Sin estas variables,
# fuera de producción funciona un simulador (no envía nada real).
# PUBLIC_URL debe ser https: Twilio llama a los webhooks con esa dirección.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── IA (OpenRouter, igual que katu_school) ──
# Bot de domicilios por WhatsApp. El modelo debe soportar herramientas (tools).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Correo (SendGrid, igual que katu_school) ──
# Campañas de marketing. Remitente: dominio verificado de Katú con el nombre del comercio.
# Sin clave, fuera de producción funciona un simulador (no envía nada real).
SENDGRID_API_KEY=
SENDGRID_FROM=
